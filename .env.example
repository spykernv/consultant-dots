# Copier en .env.local pour surcharger les valeurs par défaut.

# Modèle utilisé par Claude Code en mode headless (claude -p)
CONSULTANT_DOTS_MODEL=claude-opus-5-5
# Modèle(s) de repli si le modèle principal est surchargé ou indisponible
CONSULTANT_DOTS_FALLBACK_MODEL=claude-opus-5

# Chemin complet vers claude.exe (laisser vide pour l'auto-détection)
CONSULTANT_DOTS_CLAUDE_BIN=

# subscription : utilise ta connexion Claude (les variables de clé API, *_API_KEY et *_AUTH_TOKEN, sont retirées de l'environnement du process claude)
# inherit      : transmet l'environnement tel quel (une clé API définie prend alors le dessus sur la connexion Claude)
CONSULTANT_DOTS_CLAUDE_AUTH=subscription

# 1 = enregistre les sorties validées des cas d'exemple dans fixtures/mock/<cas>/ (alimente le mode démo)
CONSULTANT_DOTS_RECORD_FIXTURES=0
